<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_pm_hr_appraisal_form" model="ir.ui.view">
        <field name="name">pm.hr.appraisal.form</field>
        <field name="model">pm.hr.appraisal</field>
        <field name="arch" type="xml">
            <form string="Đánh giá hiệu suất">
                <header>
                    <button name="action_self_eval" string="Bắt đầu Tự đánh giá" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_manager_eval" string="Gửi Quản lý đánh giá" type="object" invisible="state != 'self_eval'" class="oe_highlight"/>
                    <button name="action_done" string="Hoàn tất Đánh giá" type="object" invisible="state != 'manager_eval'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,self_eval,manager_eval,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="manager_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="period"/>
                            <field name="date_close"/>
                            <field name="score_project"/>
                            <field name="score_competency"/>
                            <field name="score_final"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ý kiến tự đánh giá" name="page_self">
                            <field name="self_comments" placeholder="Nhân viên tự đánh giá kết quả đạt được..."/>
                        </page>
                        <page string="Nhận xét của Quản lý" name="page_manager">
                            <field name="manager_comments" placeholder="Quản lý đưa ra phản hồi và chỉ tiêu phát triển..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_pm_hr_appraisal_tree" model="ir.ui.view">
        <field name="name">pm.hr.appraisal.tree</field>
        <field name="model">pm.hr.appraisal</field>
        <field name="arch" type="xml">
            <tree string="Đánh giá hiệu suất">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="period"/>
                <field name="score_final"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Action for Appraisal -->
    <record id="action_pm_hr_appraisal" model="ir.actions.act_window">
        <field name="name">Đánh giá hiệu suất</field>
        <field name="res_model">pm.hr.appraisal</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Under HR Root -->
    <menuitem id="menu_hr_appraisal_list" name="Đánh giá hiệu suất" parent="pm_hr_employee.menu_hr_root" action="action_pm_hr_appraisal" sequence="70"/>
</odoo>
