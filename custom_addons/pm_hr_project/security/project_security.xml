<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record Rule: PM & Members Project Access -->
        <record id="project_project_manager_rule" model="ir.rule">
            <field name="name">PM Project Security Rule</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('pm_hr_base.group_manager'))]"/>
        </record>

        <!-- Record Rule: Admin & Executive full view -->
        <record id="project_project_executive_admin_rule" model="ir.rule">
            <field name="name">Executive Project Full View Rule</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('pm_hr_base.group_executive')), (4, ref('pm_hr_base.group_admin'))]"/>
        </record>
    </data>
</odoo>
