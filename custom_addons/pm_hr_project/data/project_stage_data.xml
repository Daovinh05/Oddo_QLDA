<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Default Task Kanban Stages -->
        <record id="stage_task_assigned" model="project.task.type">
            <field name="name">Đã giao</field>
            <field name="sequence">10</field>
        </record>

        <record id="stage_task_in_progress" model="project.task.type">
            <field name="name">Chưa hoàn thành / Đang làm</field>
            <field name="sequence">20</field>
        </record>

        <record id="stage_task_pending_review" model="project.task.type">
            <field name="name">Chờ duyệt</field>
            <field name="sequence">30</field>
        </record>

        <record id="stage_task_approved" model="project.task.type">
            <field name="name">Đã duyệt</field>
            <field name="sequence">40</field>
        </record>

        <record id="stage_task_completed" model="project.task.type">
            <field name="name">Đã hoàn thành</field>
            <field name="sequence">50</field>
            <field name="fold">True</field>
        </record>
    </data>
</odoo>
