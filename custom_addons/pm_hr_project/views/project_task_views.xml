<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task Kanban View -->
    <record id="view_project_task_kanban_pmhr" model="ir.ui.view">
        <field name="name">project.task.kanban.pmhr</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">stage_id</attribute>
                <attribute name="quick_create">true</attribute>
            </xpath>
        </field>
    </record>

    <!-- Task Form Extension -->
    <record id="view_project_task_form_pmhr" model="ir.ui.view">
        <field name="name">project.task.form.pmhr</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="milestone_id"/>
                <field name="progress" widget="progressbar"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Task phụ thuộc (Blocking)" name="page_dependencies">
                    <field name="depend_on_ids">
                        <tree>
                            <field name="name"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="stage_id"/>
                            <field name="date_deadline"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Task Tree/List Extension -->
    <record id="view_project_task_tree_pmhr" model="ir.ui.view">
        <field name="name">project.task.tree.pmhr</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-danger">date_deadline and date_deadline &lt; current_date and stage_id and not stage_id.fold</attribute>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="milestone_id"/>
                <field name="progress" widget="progressbar"/>
            </xpath>
        </field>
    </record>

    <!-- Milestone Form View -->
    <record id="view_project_milestone_form" model="ir.ui.view">
        <field name="name">project.milestone.form</field>
        <field name="model">project.milestone</field>
        <field name="arch" type="xml">
            <form string="Mốc dự án">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="deadline"/>
                            <field name="is_reached"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Công việc liên quan">
                            <field name="task_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Milestone Tree View -->
    <record id="view_project_milestone_tree" model="ir.ui.view">
        <field name="name">project.milestone.tree</field>
        <field name="model">project.milestone</field>
        <field name="arch" type="xml">
            <tree string="Mốc dự án">
                <field name="name"/>
                <field name="project_id"/>
                <field name="deadline"/>
                <field name="is_reached"/>
            </tree>
        </field>
    </record>

    <!-- Action for Milestones -->
    <record id="action_project_milestone" model="ir.actions.act_window">
        <field name="name">Mốc dự án</field>
        <field name="res_model">project.milestone</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
