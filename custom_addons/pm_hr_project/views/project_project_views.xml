<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Project Form View Extension -->
    <record id="view_project_project_form_pmhr" model="ir.ui.view">
        <field name="name">project.project.form.pmhr</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <h1>
                    <field name="code" readonly="1" placeholder="Mã dự án..."/>
                </h1>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="department_id"/>
                <field name="priority" widget="priority"/>
                <field name="risk_level"/>
                <field name="health_status" widget="badge" 
                       decoration-success="health_status == 'on_track'" 
                       decoration-warning="health_status == 'at_risk'" 
                       decoration-danger="health_status == 'delayed'"/>
                <field name="progress" widget="progressbar"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Ngân sách &amp; Tài chính" name="page_budget">
                    <group>
                        <group string="Ngân sách">
                            <field name="budget_planned"/>
                            <field name="budget_actual"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </page>
                <page string="Mốc dự án (Milestones)" name="page_milestones">
                    <field name="milestone_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="deadline"/>
                            <field name="is_reached"/>
                        </tree>
                    </field>
                </page>
                <page string="Thành viên tham gia" name="page_members">
                    <field name="member_ids" widget="many2many_tags"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Project Project Tree/List View Extension -->
    <record id="view_project_project_tree_pmhr" model="ir.ui.view">
        <field name="name">project.project.tree.pmhr</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="code"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="department_id"/>
                <field name="budget_planned" sum="Tổng KH"/>
                <field name="budget_actual" sum="Tổng TT"/>
                <field name="health_status" widget="badge" 
                       decoration-success="health_status == 'on_track'" 
                       decoration-warning="health_status == 'at_risk'" 
                       decoration-danger="health_status == 'delayed'"/>
                <field name="progress" widget="progressbar"/>
            </xpath>
        </field>
    </record>

    <!-- Project Project Pivot View -->
    <record id="view_project_project_pivot_pmhr" model="ir.ui.view">
        <field name="name">project.project.pivot.pmhr</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <pivot string="Phân tích Ngân sách Dự án">
                <field name="department_id" type="row"/>
                <field name="budget_planned" type="measure"/>
                <field name="budget_actual" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Project Project Graph View -->
    <record id="view_project_project_graph_pmhr" model="ir.ui.view">
        <field name="name">project.project.graph.pmhr</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <graph string="So sánh Ngân sách Dự án" type="bar">
                <field name="name" type="row"/>
                <field name="budget_planned" type="measure"/>
                <field name="budget_actual" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View Extension -->
    <record id="view_project_project_search_pmhr" model="ir.ui.view">
        <field name="name">project.project.search.pmhr</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Dự án rủi ro cao" name="filter_high_risk" domain="[('risk_level', '=', 'high')]"/>
                <filter string="Chậm tiến độ" name="filter_delayed" domain="[('health_status', '=', 'delayed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Phòng ban" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Sức khỏe dự án" name="group_health" context="{'group_by': 'health_status'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
