<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_attendance_tree_pmhr" model="ir.ui.view">
        <field name="name">hr.attendance.tree.pmhr</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="punctuality_status" widget="badge"
                       decoration-success="punctuality_status == 'on_time'"
                       decoration-warning="punctuality_status == 'late'"
                       decoration-danger="punctuality_status == 'early_leave'"/>
            </xpath>
        </field>
    </record>
</odoo>
