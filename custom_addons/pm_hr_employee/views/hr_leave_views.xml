<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_leave_tree_pmhr" model="ir.ui.view">
        <field name="name">hr.leave.tree.pmhr</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="approval_stage" widget="badge"
                       decoration-info="approval_stage == 'confirm'"
                       decoration-warning="approval_stage == 'validate1'"
                       decoration-success="approval_stage == 'validate'"
                       decoration-danger="approval_stage == 'refuse'"/>
            </xpath>
        </field>
    </record>
</odoo>
