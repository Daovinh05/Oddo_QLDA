<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- HR Officer Full Access Rule -->
        <record id="hr_employee_officer_rule" model="ir.rule">
            <field name="name">HR Officer Full Access</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('pm_hr_base.group_hr_officer')), (4, ref('pm_hr_base.group_admin'))]"/>
        </record>

        <!-- Department Manager Employee Access Rule -->
        <record id="hr_employee_manager_rule" model="ir.rule">
            <field name="name">Department Manager Employee Access</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">['|', ('department_id.manager_id.user_id', '=', user.id), ('parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('pm_hr_base.group_manager'))]"/>
        </record>
    </data>
</odoo>
